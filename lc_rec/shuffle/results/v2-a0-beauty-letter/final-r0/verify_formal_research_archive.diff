+def physical(path):
+    """Resolve retained members while leaving the original receipt paths intact."""
+    if ARCHIVE is None:
+        return path
+    path = Path(path)
+    if path in BOUND_PATHS:
+        return ARCHIVE / BOUND_PATHS[path]
+    if path == RELEASE / 'RUN_VERSION.json':
+        return ARCHIVE / 'publication/run.json'
+    if path.is_relative_to(RELEASE):
+        return ARCHIVE / 'source' / path.relative_to(RELEASE)
+    if path.is_relative_to(BASE / 'jobs'):
+        return ARCHIVE / 'jobs' / path.relative_to(BASE / 'jobs')
+    if path.is_relative_to(ROOT / 'cpu-replay-r3'):
+        return ARCHIVE / 'replay' / path.relative_to(ROOT / 'cpu-replay-r3')
+    for mode in MODES:
+        generation = ROOT / f'gpu-formal-{mode}-r0'
+        evaluation = ROOT / f'cpu-eval-{mode}-r0'
+        if path == generation / 'test/derived.rank0.py':
+            return ARCHIVE / 'execution/derived/derived.rank0.py'
+        if path.is_relative_to(generation / 'test'):
+            return ARCHIVE / 'conditions' / mode / 'test' / path.relative_to(generation / 'test')
+        if path.is_relative_to(generation):
+            return ARCHIVE / 'conditions' / mode / 'execution' / path.relative_to(generation)
+        if path.is_relative_to(evaluation):
+            return ARCHIVE / 'conditions' / mode / 'evaluation' / path.relative_to(evaluation)
+    raise ValueError(f'No archive member bound for original path {path}')
+
