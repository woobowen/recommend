        {
          "line": 76,
          "text": "def merge_list_of_keyed_tensors_to_single_tensor("
        },
        {
          "line": 77,
          "text": "    data: list[dict[str, torch.Tensor]],"
        },
        {
          "line": 78,
          "text": "    index_key: str,"
        },
        {
          "line": 79,
          "text": "    value_key: str,"
        },
        {
          "line": 80,
          "text": ") -> torch.Tensor:"
        },
        {
          "line": 81,
          "text": "    \"\"\""
        },
        {
          "line": 82,
          "text": "    Converts a list of dictionaries of id to tensors into a single tensor by squeezing"
        },
        {
          "line": 83,
          "text": "    the tensors along the specified index key."
        },
        {
          "line": 84,
          "text": "    e.g.,"
        },
        {
          "line": 85,
          "text": "    data = ["
        },
        {
          "line": 86,
          "text": "    ["
        },
        {
          "line": 87,
          "text": "        {'user_id': 123,"
        },
        {
          "line": 88,
          "text": "        {'semantic_id': torch.tensor([21, 32, 124]),"
        },
        {
          "line": 89,
          "text": "        other features.....}"
        },
        {
          "line": 90,
          "text": "        ],"
        },
        {
          "line": 91,
          "text": "    ["
        },
        {
          "line": 92,
          "text": "        {'user_id': 456,"
        },
        {
          "line": 93,
          "text": "        {'semantic_id': torch.tensor([11, 22, 33]),"
        },
        {
          "line": 94,
          "text": "        other features.....}"
        },
        {
          "line": 95,
          "text": "    ]"
        },
        {
          "line": 96,
          "text": "    output:"
        },
        {
          "line": 97,
          "text": "    tensor([...,"
        },
        {
          "line": 98,
          "text": "            [21, 32, 124], # row 123"
        },
        {
          "line": 99,
          "text": "            ...,"
        },
        {
          "line": 100,
          "text": "            [11, 22, 33], # row 456"
        },
        {
          "line": 101,
          "text": "            ..."
        },
        {
          "line": 102,
          "text": "            ])"
        },
        {
          "line": 103,
          "text": ""
        },
        {
          "line": 104,
          "text": "    Args:"
        },
        {
          "line": 105,
          "text": "        data (list[dict[str, torch.Tensor]]): A list of dictionaries where each dictionary"
        },
        {
          "line": 106,
          "text": "            contains an index key and a value key."
        },
        {
          "line": 107,
          "text": "        index_key (str): The key in the dictionary that contains the index for each row."
        },
        {
          "line": 108,
          "text": "        value_key (str): The key in the dictionary that contains the tensor to be merged."
        },
        {
          "line": 109,
          "text": "    \"\"\""
        },
        {
          "line": 110,
          "text": "    batch_size = len(data)"
        },
        {
          "line": 111,
          "text": "    dimensions = torch.tensor(data[0][value_key]).size()"
        },
        {
          "line": 112,
          "text": "    output_tensor = torch.zeros((batch_size, *dimensions))"
        },
        {
          "line": 113,
          "text": "    for row in data:"
        },
        {
          "line": 114,
          "text": "        index = row[index_key]"
        },
        {
          "line": 115,
          "text": "        value = row[value_key]"
        },
        {
          "line": 116,
          "text": "        if index < batch_size:"
        },
        {
          "line": 117,
          "text": "            output_tensor[index] = torch.tensor(value)"
        },
        {
          "line": 118,
          "text": "        else:"
        },
        {
          "line": 119,
          "text": "            raise IndexError("
        },
        {
          "line": 120,
          "text": "                f\"Index {index} out of bounds for batch size {batch_size}.\""
        },
        {
          "line": 121,
          "text": "            )"
        },
        {
          "line": 122,
          "text": "    return output_tensor"
        },
        {
          "line": 146,
          "text": "    # Use torch.unique to get unique rows and their inverse indices"
        },
        {
          "line": 147,
          "text": "    unique_rows, inverse_indices, counts = torch.unique("
        },
        {
          "line": 148,
          "text": "        data, dim=0, return_inverse=True, return_counts=True"
        },
        {
          "line": 149,
          "text": "    )"
        },
        {
          "line": 150,
          "text": ""
        },
        {
          "line": 151,
          "text": "    output_indices = torch.zeros_like(inverse_indices)"
        },
        {
          "line": 152,
          "text": ""
        },
        {
          "line": 153,
          "text": "    # Find indices where counts > 1 (meaning duplicates exist)"
        },
        {
          "line": 154,
          "text": "    duplicate_indices = torch.where(counts > 1)[0]"
        },
        {
          "line": 155,
          "text": ""
        },
        {
          "line": 156,
          "text": "    for i in range(len(duplicate_indices)):"
        },
        {
          "line": 157,
          "text": "        # Calculate number of collisions"
        },
        {
          "line": 158,
          "text": "        num_of_collisions = counts[duplicate_indices[i]]"
        },
        {
          "line": 159,
          "text": ""
        },
        {
          "line": 160,
          "text": "        # Gather the indices where the collisions occur"
        },
        {
          "line": 161,
          "text": "        indices_to_change = torch.where(inverse_indices == duplicate_indices[i])[0]"
        },
        {
          "line": 162,
          "text": ""
        },
        {
          "line": 163,
          "text": "        # Create a range based on the number of collision, starting from 1"
        },
        {
          "line": 164,
          "text": "        range_to_add = torch.arange(1, num_of_collisions + 1)"
        },
        {
          "line": 165,
          "text": ""
        },
        {
          "line": 166,
          "text": "        # Scatter to those specific indices"
        },
        {
          "line": 167,
          "text": "        output_indices = output_indices.scatter(0, indices_to_change, range_to_add)"
        },
        {
          "line": 168,
          "text": ""
        },
        {
          "line": 169,
          "text": "    # Concatenate the duplicate indicator column to the original data"
        },
        {
          "line": 170,
          "text": "    result = torch.cat((data, output_indices.unsqueeze(1)), dim=1).long()"
        },
        {
          "line": 171,
          "text": "    if return_tensor:"
        },
        {
          "line": 172,
          "text": "        return result"
        },
        {
          "line": 173,
          "text": "    else:"
        },
        {
          "line": 174,
          "text": "        # Save the result to a file"
        },
        {
          "line": 175,
          "text": "        torch.save(result, file_path)"
        },
        {
          "line": 176,
          "text": "        return None"
        },
        {
          "line": 179,
          "text": "def transpose_tensor_from_file("
        },
        {
          "line": 180,
          "text": "    file_path: Optional[str] = None,"
        },
        {
          "line": 181,
          "text": "    return_tensor: bool = False,"
        },
        {
          "line": 182,
          "text": "    dim1: int = -2,"
        },
        {
          "line": 183,
          "text": "    dim2: int = -1,"
        },
        {
          "line": 184,
          "text": ") -> Union[None, torch.Tensor]:"
        },
        {
          "line": 185,
          "text": "    \"\"\""
        },
        {
          "line": 186,
          "text": "    Transposes a PyTorch tensor from a file accoridng to designated dimensions."
        },
        {
          "line": 187,
          "text": ""
        },
        {
          "line": 188,
          "text": "    Args:"
        },
        {
          "line": 189,
          "text": "        file_path: Optional; Path to a file containing the tensor data."
        },
        {
          "line": 190,
          "text": "        return_tensor: If True, returns the modified tensor; otherwise, saves it to the file."
        },
        {
          "line": 191,
          "text": "        dim1: The first dimension to transpose (default: -2)."
        },
        {
          "line": 192,
          "text": "        dim2: The second dimension to transpose (default: -1)."
        },
        {
          "line": 193,
          "text": "    Returns:"
        },
        {
          "line": 194,
          "text": "        If return_tensor is True, returns the modified tensor. If False, saves the modified tensor to the file."
        },
        {
          "line": 195,
          "text": "    \"\"\""
        },
        {
          "line": 196,
          "text": "    if not file_path.endswith(\".pt\"):"
        },
        {
          "line": 197,
          "text": "        return None"
        },
        {
          "line": 198,
          "text": "    data = torch.load(open_local_or_remote(file_path, mode=\"rb\"))"
        },
        {
          "line": 199,
          "text": ""
        },
        {
          "line": 200,
          "text": "    # Transpose the tensor"
        },
        {
          "line": 201,
          "text": "    result = data.transpose(dim1, dim2)"
        },
        {
          "line": 202,
          "text": "    if return_tensor:"
        },
        {
          "line": 203,
          "text": "        return result"
        },
        {
          "line": 204,
          "text": "    else:"
        },
        {
          "line": 205,
          "text": "        # Save the result to a file"
        },
        {
          "line": 206,
          "text": "        torch.save(result, file_path)"
        },
        {
          "line": 207,
          "text": "        return None"
        }
      ]
    },
